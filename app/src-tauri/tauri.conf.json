{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chordial",
  "version": "0.1.0",
  "identifier": "app.chordial.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "chordial",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      },
      {
        "label": "deer",
        "title": "deer",
        "url": "deer.html",
        "width": 270,
        "height": 500,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:8484 ws://localhost:8484 http://localhost:8485 ws://localhost:8485 https://api.internetcreature.dev wss://api.internetcreature.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
